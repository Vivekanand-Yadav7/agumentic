datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  role          String    @default("employee") // "admin" | "employer" | "employee"
  status        String    @default("active")   // "active" | "inactive"
  avatar        String?
  address       String?
  department    String?
  designation   String?
  salary        Float     @default(0)
  joiningDate   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  projectAssignments  ProjectAssignment[]
  leaveRequests       Leave[]              @relation("LeaveEmployee")
  leaveApprovals      Leave[]              @relation("LeaveApprover")
  payrolls            Payroll[]
  attendances         Attendance[]
}

model Project {
  id          String    @id @default(uuid())
  title       String
  description String?
  location    String?
  type        String    @default("residential") // "residential" | "commercial" | "land" | "rental"
  status      String    @default("ongoing") // "planning" | "ongoing" | "completed" | "on_hold"
  startDate   DateTime?
  endDate     DateTime?
  budget      Float     @default(0)
  clientName  String?
  clientPhone String?
  priority    String    @default("medium") // "low" | "medium" | "high"
  progress    Int       @default(0) // 0-100
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id          String   @id @default(uuid())
  role        String   @default("member") // "lead" | "member"
  assignedAt  DateTime @default(now())

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model Leave {
  id          String    @id @default(uuid())
  type        String    // "sick" | "casual" | "annual" | "unpaid" | "maternity" | "other"
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  remarks     String?   // approver's comment
  appliedAt   DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employeeId  String
  employee    User      @relation("LeaveEmployee", fields: [employeeId], references: [id])
  approverId  String?
  approver    User?     @relation("LeaveApprover", fields: [approverId], references: [id])
}

model Payroll {
  id              String   @id @default(uuid())
  month           Int      // 1-12
  year            Int
  basicSalary     Float
  hra             Float    @default(0)
  allowances      Float    @default(0)
  deductions      Float    @default(0)
  tax             Float    @default(0)
  netSalary       Float
  status          String   @default("pending") // "pending" | "paid"
  paidAt          DateTime?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employeeId      String
  employee        User     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
}

model Attendance {
  id         String   @id @default(uuid())
  date       DateTime
  checkIn    String?  // "09:00"
  checkOut   String?  // "18:00"
  status     String   @default("present") // "present" | "absent" | "half_day" | "wfh"
  remarks    String?
  createdAt  DateTime @default(now())

  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}
